{
  "$schema": "https://opencode.ai/config.json",
  "mcp": { "context7": {}, "playwright": {}, "supabase": {} },
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "https://9router.emprestamais.shop/v1", "apiKey": "{env:NINEROUTER_KEY}" },
      "models": { "combo": { "name": "combo" } }
    },
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "https://integrate.api.nvidia.com/v1", "apiKey": "{env:NVIDIA_API_KEY}" },
      "models": { "nemotron-3-ultra-550b-a55b": { "name": "Nemotron 3 Ultra" } }
    }
  },
  "model": "9router/combo",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"]
}
