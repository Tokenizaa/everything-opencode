# ============================================================
# RAG + Embedding Template — Configuração de Ambiente
# ============================================================
# Copie para .env.local e preencha com suas chaves
# ============================================================

# ============================================================
# SUPABASE (obrigatório)
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# ============================================================
# EMBEDDING PROVIDERS (escolha um ou mais)
# ============================================================

# NVIDIA (recomendado - gratuito via 9Router)
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# 9Router (gateway multi-provider, gratuito)
NINEROUTER_URL=http://localhost:20128
NINEROUTER_KEY=your_9router_key
NINEROUTER_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# OpenAI (pago)
# OPENAI_API_KEY=sk-...
# OPENAI_EMBED_MODEL=text-embedding-3-small

# OpenRouter (proxy para múltiplos providers)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# Local (Python/sentence-transformers) - gratuito, roda local
# LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================
# SUPABASE (obrigatório para pgvector)
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# ============================================================
# 9ROUTER (Gateway multi-provider, gratuito)
# ============================================================
NINEROUTER_URL=http://localhost:20128
NINEROUTER_KEY=your_9router_key
NINEROUTER_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# ============================================================
# APP CONFIG
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# ============================================================
# OPTIONAL: Outros providers
# ============================================================
# OPENAI_API_KEY=sk-...
# OPENAI_EMBED_MODEL=text-embedding-3-small

# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# FIRECRAWL_API_KEY=fc-...
# JINA_API_KEY=jina_...
# COHERE_API_KEY=...
# VOYAGE_API_KEY=...
EOF